# Local development persists to .data/postgres when DATABASE_URL is unset.
# On Vercel DATABASE_URL is required: use a pooled PostgreSQL URL (e.g. Neon).
DATABASE_URL=
PUBLIC_APP_URL=
# For the explicit admin:create command only; never expose these to clients.
BOOTSTRAP_PHONE=
BOOTSTRAP_NAME=
BOOTSTRAP_GRADE=
BOOTSTRAP_PASSWORD=
